# Copie para .env e preencha. Todas as variáveis usam o prefixo ESTUDAI_.

# REQUESTS_PER_MINUTE: limitador de taxa compartilhado por modelo. O plano gratuito do
# Gemini 3 Flash permite 5 req/min (use 4.5 por folga); com faturamento, remova ou aumente.

# --- Modelos por nível de capacidade (Seção 3 da metodologia) ---
# provider: gemini | openai_compat | openrouter | claude_cli
ESTUDAI_ECONOMIC__PROVIDER=gemini
# ESTUDAI_ECONOMIC__REQUESTS_PER_MINUTE=4.5
ESTUDAI_ECONOMIC__MODEL=gemini-3-flash-preview
ESTUDAI_ECONOMIC__PRICE_INPUT_PER_MTOK=0.30
ESTUDAI_ECONOMIC__PRICE_OUTPUT_PER_MTOK=2.50

# Muse Spark 1.3: preencha base_url/modelo do endpoint compatível com a API da OpenAI que vocês usarem.
ESTUDAI_FRONTIER__PROVIDER=openai_compat
# ESTUDAI_FRONTIER__REQUESTS_PER_MINUTE=4.5
ESTUDAI_FRONTIER__MODEL=muse-spark-1.3
ESTUDAI_FRONTIER__BASE_URL=https://seu-endpoint/v1
ESTUDAI_FRONTIER__PRICE_INPUT_PER_MTOK=1.00
ESTUDAI_FRONTIER__PRICE_OUTPUT_PER_MTOK=4.00

# --- Alternativa: OpenRouter (um provedor, centenas de modelos; chave em https://openrouter.ai/keys) ---
# O exemplo abaixo é exatamente a configuração da metodologia: Gemini 3 Flash (econômico) + Muse Spark 1.3 (fronteira).
# model = "fornecedor/modelo" como aparece no site do OpenRouter. O custo real de cada chamada vem
# na resposta e vai para a telemetria. Se um modelo não aceitar json_schema, troque o
# STRUCTURED_OUTPUT_METHOD para function_calling (ou json_mode). Modelos ":free" têm limite por minuto/dia.
# ESTUDAI_OPENROUTER_API_KEY=sk-or-v1-...
# ESTUDAI_ECONOMIC__PROVIDER=openrouter
# ESTUDAI_ECONOMIC__MODEL=google/gemini-3-flash-preview
# ESTUDAI_FRONTIER__PROVIDER=openrouter
# ESTUDAI_FRONTIER__MODEL=meta/muse-spark-1.3
# ESTUDAI_FRONTIER__STRUCTURED_OUTPUT_METHOD=json_schema
# Dois juízes de fornecedores diferentes permitem o κ entre juízes; o 1º decide as transições de aprendizagem.
# ESTUDAI_JUDGES=[{"provider":"openrouter","model":"openai/gpt-5-mini"},{"provider":"openrouter","model":"google/gemini-3-flash-preview"}]

# --- Alternativa: Claude Code CLI como motor (se o `claude` estiver instalado e logado) ---
# Usa a autenticação do próprio CLI (assinatura ou chave), sem chave aqui. Não há temperature;
# cada chamada abre um processo (~6 s). Use ids completos: os aliases (haiku/sonnet/opus) do CLI
# podem apontar para gerações antigas. Teste com: uv run estudai verificar-modelos
# ESTUDAI_ECONOMIC__PROVIDER=claude_cli
# ESTUDAI_ECONOMIC__MODEL=claude-haiku-5-5
# ESTUDAI_FRONTIER__PROVIDER=claude_cli
# ESTUDAI_FRONTIER__MODEL=claude-sonnet-5-5
# ESTUDAI_FRONTIER__EFFORT=medium
# ESTUDAI_JUDGES=[{"provider":"claude_cli","model":"claude-sonnet-5-5"}]

# Painel de resolutores (opcional; padrão = 3x o modelo de fronteira). Lista JSON de modelos.
# ESTUDAI_PANEL=[{"provider":"openai_compat","model":"muse-spark-1.3","base_url":"https://seu-endpoint/v1"},{"provider":"gemini","model":"gemini-3-flash-preview"},{"provider":"gemini","model":"gemini-3-flash-preview"}]

# Juízes da avaliação: idealmente de outro fornecedor (Q. Xu, 2026). Com 2+ juízes o relatório calcula κ.
ESTUDAI_JUDGES=[{"provider":"gemini","model":"gemini-3-flash-preview"}]

# Estudante simulado (opcional; padrão = modelo econômico)
# ESTUDAI_STUDENT={"provider":"gemini","model":"gemini-3-flash-preview"}

# Limites de execução
# ESTUDAI_MAX_RODADAS_TUTORIA=6
# ESTUDAI_EXERCICIOS_POR_SESSAO=8

# --- Credenciais ---
ESTUDAI_GEMINI_API_KEY=
ESTUDAI_OPENAI_API_KEY=

# --- Embeddings: gemini | sentencetransformers ---
ESTUDAI_EMBEDDING_PROVIDER=gemini
ESTUDAI_EMBEDDING_MODEL=gemini-embedding-001
# Similaridade mínima (cosseno) para SEMANTICA/HIBRIDA entrarem no RAG. 0.65 foi calibrado para o
# gemini-embedding-001; ao trocar o modelo de embeddings, recalibre. TEXTUAL (BM25) não usa este corte.
# ESTUDAI_KB_MIN_SCORE=0.65

# Parameters for sentence transformers embedders (according to model card). Example below is for microsoft/harrier-oss-v1-270m
ESTUDAI_EMBEDDING_QUERY_PARAMS={"prompt_name": "web_search_query"}
ESTUDAI_EMBEDDING_DOC_PARAMS={}
