# ==== ESSENCIAL (preencher para uso padrão) ====

# --- Modelos Utilizados ---
# provider: gemini | openai_compat | openrouter
# Padrão utilizado pelo desenvolvimento: DeepSeek Flash (econômico/fronteira) + Gemini 3 Flash (juízes).
ESTUDAI_ECONOMIC__PROVIDER=openai_compat
ESTUDAI_ECONOMIC__MODEL=deepseek-flash
ESTUDAI_ECONOMIC__BASE_URL=https://api.deepseek.com
ESTUDAI_ECONOMIC__PRICE_INPUT_PER_MTOK=0.30
ESTUDAI_ECONOMIC__PRICE_OUTPUT_PER_MTOK=2.50
ESTUDAI_ECONOMIC__EXTRA_BODY='{"thinking":{"type":"disabled"}}'
ESTUDAI_ECONOMIC__STRUCTURED_OUTPUT_METHOD=function_calling

#Util caso o endpoint é limitado
# ESTUDAI_ECONOMIC__REQUESTS_PER_MINUTE=4.5

#Provedor do modelo de fronteira
ESTUDAI_FRONTIER__PROVIDER=openai_compat
ESTUDAI_FRONTIER__MODEL=deepseek-flash
ESTUDAI_FRONTIER__BASE_URL=https://api.deepseek.com
ESTUDAI_FRONTIER__PRICE_INPUT_PER_MTOK=0.30
ESTUDAI_FRONTIER__PRICE_OUTPUT_PER_MTOK=2.50
ESTUDAI_FRONTIER__EXTRA_BODY='{"thinking":{"type":"disabled"}}'
ESTUDAI_FRONTIER__STRUCTURED_OUTPUT_METHOD=function_calling

#Util caso o endpoint é limitado
# ESTUDAI_FRONTIER__REQUESTS_PER_MINUTE=4.5

# --- Credenciais ---
# Endpoints openai_compat usam ESTUDAI_OPENAI_API_KEY.
ESTUDAI_OPENAI_API_KEY=
# Juízes e embeddings Gemini usam ESTUDAI_GEMINI_API_KEY.
ESTUDAI_GEMINI_API_KEY=

# --- Embeddings: gemini | sentencetransformers ---
ESTUDAI_EMBEDDING_PROVIDER=gemini
ESTUDAI_EMBEDDING_MODEL=gemini-embedding-001

# Parâmetros do sentence-transformers (conforme o model card). Exemplo para microsoft/harrier-oss-v1-270m
ESTUDAI_EMBEDDING_QUERY_PARAMS={"prompt_name": "web_search_query"}
ESTUDAI_EMBEDDING_DOC_PARAMS={}

# ==== Extras (Config/Modelos usados só para avaliação) ====

# Painel de resolutores (opcional, caso vazio é utilizado o modelo de fronteira)
# ESTUDAI_PANEL=[{"provider":"openai_compat","model":"deepseek-flash","base_url":"https://api.deepseek.com"},{"provider":"gemini","model":"gemini-3-flash"},{"provider":"gemini","model":"gemini-3-flash"}]

# Juízes da avaliação: idealmente de outro fornecedor. Utilizado apenas para avaliação.
ESTUDAI_JUDGES='[{"provider":"gemini","model":"gemini-3-flash"}]'

# Estudante simulado para avaliação. Utilizado o modelo econômico caso não especificado
# ESTUDAI_STUDENT='{"provider":"gemini","model":"gemini-3-flash"}'

# --- Config para OpenRouter ---
# model = "fornecedor/modelo" como aparece no site do OpenRouter. O custo real de cada chamada vem
# na resposta e vai para a telemetria. Se um modelo não aceitar json_schema, troque o
# STRUCTURED_OUTPUT_METHOD para function_calling (ou json_mode). Modelos ":free" têm limite por minuto/dia.
# ESTUDAI_OPENROUTER_API_KEY=sk-or-v1-...
# ESTUDAI_ECONOMIC__PROVIDER=openrouter
# ESTUDAI_ECONOMIC__MODEL=fornecedor/modelo
# ESTUDAI_FRONTIER__PROVIDER=openrouter
# ESTUDAI_FRONTIER__MODEL=fornecedor/modelo
# ESTUDAI_FRONTIER__STRUCTURED_OUTPUT_METHOD=json_schema
# Dois juízes de fornecedores diferentes permitem o κ entre juízes; o 1º decide as transições de aprendizagem.
# ESTUDAI_JUDGES=[{"provider":"openrouter","model":"fornecedor/modelo"},{"provider":"openrouter","model":"outro-fornecedor/modelo"}]

# Exemplo opencode go usado para avaliação
# ESTUDAI_OPENAI_API_KEY=<chave OpenCode Go>
# ESTUDAI_ECONOMIC__PROVIDER=openai_compat
# ESTUDAI_ECONOMIC__MODEL=deepseek-v4.1-flash
# ESTUDAI_ECONOMIC__BASE_URL=https://opencode.ai/inference/go/openai/v1
# ESTUDAI_ECONOMIC__PRICE_INPUT_PER_MTOK=0.15
# ESTUDAI_ECONOMIC__PRICE_OUTPUT_PER_MTOK=0.60
# ESTUDAI_ECONOMIC__STRUCTURED_OUTPUT_METHOD=function_calling
# ESTUDAI_ECONOMIC__DEFAULT_HEADERS='{"User-Agent":"estudai/1.0","x-opencode-session":"estudai"}'
# ESTUDAI_FRONTIER__PROVIDER=openai_compat
# ESTUDAI_FRONTIER__MODEL=deepseek-v4.1-flash
# ESTUDAI_FRONTIER__BASE_URL=https://opencode.ai/inference/go/openai/v1
# ESTUDAI_FRONTIER__PRICE_INPUT_PER_MTOK=0.15
# ESTUDAI_FRONTIER__PRICE_OUTPUT_PER_MTOK=0.60
# ESTUDAI_FRONTIER__STRUCTURED_OUTPUT_METHOD=function_calling
# ESTUDAI_FRONTIER__DEFAULT_HEADERS='{"User-Agent":"estudai/1.0","x-opencode-session":"estudai"}'
# Juiz mais barato e independente do sistema; dois juízes permitem κ de Fleiss.
# ESTUDAI_JUDGES='[{"provider":"openai_compat","model":"glm-5.3-flash","base_url":"https://opencode.ai/inference/go/openai/v1","price_input_per_mtok":0.15,"price_output_per_mtok":0.50,"default_headers":{"User-Agent":"estudai/1.0","x-opencode-session":"estudai"}},{"provider":"openai_compat","model":"qwen3.8-flash","base_url":"https://opencode.ai/inference/go/openai/v1","price_input_per_mtok":0.15,"price_output_per_mtok":0.47,"default_headers":{"User-Agent":"estudai/1.0","x-opencode-session":"estudai"}}]'
# ESTUDAI_STUDENT='{"provider":"openai_compat","model":"qwen3.8-flash","base_url":"https://opencode.ai/inference/go/openai/v1","price_input_per_mtok":0.15,"price_output_per_mtok":0.47,"default_headers":{"User-Agent":"estudai/1.0","x-opencode-session":"estudai"}}'
# ESTUDAI_PANEL='[{"provider":"openai_compat","model":"deepseek-v4.1-flash","base_url":"https://opencode.ai/inference/go/openai/v1","price_input_per_mtok":0.15,"price_output_per_mtok":0.60,"default_headers":{"User-Agent":"estudai/1.0","x-opencode-session":"estudai"}},{"provider":"openai_compat","model":"glm-5.3-flash","base_url":"https://opencode.ai/inference/go/openai/v1","price_input_per_mtok":0.15,"price_output_per_mtok":0.50,"default_headers":{"User-Agent":"estudai/1.0","x-opencode-session":"estudai"}},{"provider":"openai_compat","model":"qwen3.8-flash","base_url":"https://opencode.ai/inference/go/openai/v1","price_input_per_mtok":0.15,"price_output_per_mtok":0.47,"default_headers":{"User-Agent":"estudai/1.0","x-opencode-session":"estudai"}}]'

# -- Limites de execução -- 
# ESTUDAI_MAX_RODADAS_TUTORIA=6
# ESTUDAI_EXERCICIOS_POR_SESSAO=8
# ESTUDAI_TUTOR_MAX_STEPS=3

# Figuras dos agentes
# ESTUDAI_FIGURAS=true
# ESTUDAI_MAX_FIGURAS_TUTOR=2
# ESTUDAI_MAX_FIGURAS_EXERCICIO=1

# ESTUDAI_DATA_DIR=data

# --- LangSmith ---
# Necessário para `langgraph dev`. Para só rodar as interfaces, pode deixar desligado.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=estudai
